# Supabase Environment Variables
# Скопируйте этот файл в .env и заполните своими значениями

# ============================================
# ОСНОВНЫЕ НАСТРОЙКИ
# ============================================

# Домены
DOMAIN=bike53.ru
API_DOMAIN=api.bike53.ru
STUDIO_DOMAIN=studio.bike53.ru

# IP адрес сервера
SERVER_IP=185.225.34.252

# ============================================
# БЕЗОПАСНОСТЬ
# ============================================

# PostgreSQL пароль (сгенерируйте: openssl rand -base64 32)
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# JWT Secret (сгенерируйте: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Anon Key (получите из Supabase Studio после первого запуска)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Service Role Key (получите из Supabase Studio после первого запуска)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ============================================
# EMAIL НАСТРОЙКИ (опционально)
# ============================================

# SMTP настройки для отправки email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_ADMIN_EMAIL=admin@bike53.ru
SMTP_SENDER_NAME=Task Tracker

# ============================================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
# ============================================

# Разрешить регистрацию новых пользователей
DISABLE_SIGNUP=false

# Автоматическое подтверждение email (для разработки)
MAILER_AUTOCONFIRM=false

# Максимальный размер загружаемых файлов (в байтах)
FILE_SIZE_LIMIT=52428800

# Таймзона
TZ=Europe/Moscow

# ============================================
# ВЕРСИИ ОБРАЗОВ
# ============================================

POSTGRES_VERSION=15.1.0.117
KONG_VERSION=2.8.1
GOTRUE_VERSION=v2.99.0
POSTGREST_VERSION=v11.2.0
REALTIME_VERSION=v2.25.35
STORAGE_VERSION=v0.43.11
STUDIO_VERSION=20231123-64a766c
META_VERSION=v0.68.0

# ============================================
# ПОРТЫ (для локальной разработки)
# ============================================

POSTGRES_PORT=5432
KONG_PORT=8000
KONG_HTTPS_PORT=8443
AUTH_PORT=54323
REST_PORT=54324
REALTIME_PORT=54325
STORAGE_PORT=54326
STUDIO_PORT=54321
META_PORT=54327

# ============================================
# ПУТИ К ДАННЫМ
# ============================================

DB_DATA_PATH=./volumes/db/data
STORAGE_DATA_PATH=./volumes/storage
KONG_CONFIG_PATH=./volumes/kong

# ============================================
# ЛОГИРОВАНИЕ
# ============================================

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================
# ДОПОЛНИТЕЛЬНЫЕ ФУНКЦИИ
# ============================================

# Включить Realtime
ENABLE_REALTIME=true

# Включить Storage
ENABLE_STORAGE=true

# Включить Auth
ENABLE_AUTH=true

# ============================================
# BACKUP НАСТРОЙКИ
# ============================================

# Путь для бэкапов
BACKUP_PATH=./backups

# Расписание автоматических бэкапов (cron формат)
BACKUP_SCHEDULE=0 2 * * *

# ============================================
# МОНИТОРИНГ
# ============================================

# Включить мониторинг
ENABLE_MONITORING=false

# Prometheus порт
PROMETHEUS_PORT=9090

# Grafana порт
GRAFANA_PORT=3001
