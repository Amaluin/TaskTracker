# ============================================
# ПОЛНАЯ КОНФИГУРАЦИЯ AUTH ДЛЯ SUPABASE
# ============================================
# Скопируйте эти строки в ваш .env файл
# Замените существующие GOTRUE_* переменные
# ============================================

# === ОСНОВНЫЕ НАСТРОЙКИ ===
GOTRUE_SITE_URL=https://api.bike53.ru
GOTRUE_URI_ALLOW_LIST=*
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated

# === ОТКЛЮЧЕНИЕ EMAIL (КРИТИЧНО!) ===
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_INVITE=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_RECOVERY=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# === SMTP ОТКЛЮЧЕН ===
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_ADMIN_EMAIL=
GOTRUE_SMTP_MAX_FREQUENCY=1s
GOTRUE_SMTP_SENDER_NAME=

# === ВНЕШНИЕ ПРОВАЙДЕРЫ ===
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_EXTERNAL_PHONE_ENABLED=false
GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED=false

# === БЕЗОПАСНОСТЬ ===
GOTRUE_PASSWORD_MIN_LENGTH=6
GOTRUE_PASSWORD_REQUIRED_CHARACTERS=

# === RATE LIMITING (ОТКЛЮЧЕН ДЛЯ РАЗРАБОТКИ) ===
GOTRUE_RATE_LIMIT_HEADER=X-RateLimit-Limit
GOTRUE_RATE_LIMIT_EMAIL_SENT=1000
GOTRUE_RATE_LIMIT_SMS_SENT=1000
GOTRUE_RATE_LIMIT_TOKEN_REFRESH=1000
GOTRUE_RATE_LIMIT_VERIFY=1000

# === ЛОГИРОВАНИЕ ===
GOTRUE_LOG_LEVEL=info
GOTRUE_LOG_FILE=

# === API ===
GOTRUE_API_HOST=0.0.0.0
GOTRUE_API_PORT=9999
GOTRUE_API_EXTERNAL_URL=https://api.bike53.ru

# === DATABASE ===
GOTRUE_DB_DRIVER=postgres
# DATABASE_URL должен быть уже определен в .env
# Формат: postgresql://postgres:password@db:5432/postgres

# === WEBHOOK (ОПЦИОНАЛЬНО) ===
GOTRUE_WEBHOOK_URL=
GOTRUE_WEBHOOK_SECRET=
GOTRUE_WEBHOOK_RETRIES=3
GOTRUE_WEBHOOK_TIMEOUT_SEC=5

# === SECURITY ===
GOTRUE_SECURITY_CAPTCHA_ENABLED=false
GOTRUE_SECURITY_CAPTCHA_PROVIDER=
GOTRUE_SECURITY_CAPTCHA_SECRET=

# === SESSIONS ===
GOTRUE_SESSIONS_TIMEBOX=24h
GOTRUE_SESSIONS_INACTIVITY_TIMEOUT=0

# === OPERATOR ===
GOTRUE_OPERATOR_TOKEN=
