# Supabase .gitignore
# Добавьте эти строки в ваш основной .gitignore файл

# Environment variables
.env
.env.local
.env.production

# JWT Keys and secrets
jwt-keys.txt
*.key
*.pem

# Docker volumes (содержат данные)
volumes/
volumes/db/
volumes/storage/
volumes/kong/

# Backups
backups/
*.sql
*.tar.gz
*.backup

# SSL certificates (если хранятся локально)
*.crt
*.cert
ssl/

# Logs
*.log
logs/

# Nginx temporary files
*.pid
*.sock

# Docker
docker-compose.override.yml

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Sensitive configuration
config.local.yml
secrets.yml
